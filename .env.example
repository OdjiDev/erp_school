# Développement local. Pour Docker, copier .env.docker.example vers .env.
# Django — remplacer en production
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=

# Mettre 1 sur le cloud derrière HTTPS. Laisser 0 sur un nœud local en HTTP.
DJANGO_SECURE_SSL=0

# PostgreSQL — laisser vide pour utiliser SQLite en développement
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
