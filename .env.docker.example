# Docker Compose — copier ce fichier vers .env puis remplacer les secrets.
# Les valeurs « change-me » sont refusées par l'entrypoint en production.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL=0

POSTGRES_DB=school
POSTGRES_USER=school
POSTGRES_PASSWORD=change-me

# Image locale pour un nœud autonome. Sur un serveur alimenté par la CI/CD,
# utiliser l'image GHCR publiée, par exemple :
# APP_IMAGE=ghcr.io/odjidev/erp_school:latest
APP_IMAGE=erp-scolaire:local

# 0.0.0.0 expose l'application sur le réseau local de l'école.
# Mettre 127.0.0.1 derrière un reverse proxy installé sur l'hôte.
WEB_BIND=0.0.0.0
WEB_PORT=8000

GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
FORWARDED_ALLOW_IPS=127.0.0.1

RUN_MIGRATIONS=1
RUN_COLLECTSTATIC=1
DB_WAIT_ATTEMPTS=30
DB_WAIT_DELAY=2
